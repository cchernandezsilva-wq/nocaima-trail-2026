# ================================================================
# CONFIGURACIÓN DE NOCAIMA TRAIL 2026 - ENTORNO DE DESARROLLO
# ================================================================

# Entorno: 'sandbox' (pruebas) o 'production' (real)
WOMPI_ENVIRONMENT=sandbox
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Llaves de Wompi (Por defecto incluye llaves de Sandbox para pruebas inmediatas)
# Cuando tengas tu cuenta Wompi aprobada, reemplazas con tus llaves reales de producción
WOMPI_PUBLIC_KEY=pub_stagtest_g2u0UQyK3YxFjhTXUhST3TQvxYsMmz2x
WOMPI_PRIVATE_KEY=prv_stagtest_5Jp58NlCjN4wP1pD38vEwZvxYsMmz2x
WOMPI_INTEGRITY_SECRET=stagtest_integrity_nAIBuqayWOTRQ3UQvxYsMmz2x
WOMPI_EVENTS_SECRET=stagtest_events_nAIBuqayWOTRQ3UQvxYsMmz2x

# Moneda oficial
CURRENCY=COP

# Tarifa de pasarela de pago Wompi asumida por el corredor:
# 2.65% + $700 COP + 19% IVA sobre la comisión
WOMPI_FEE_PERCENTAGE=2.65
WOMPI_FEE_FIXED_COP=700
WOMPI_FEE_VAT_PERCENTAGE=19

# URL Base de tu web (en desarrollo localhost:3000, en Netlify https://tu-sitio.netlify.app)
SITE_URL=http://localhost:3000

# Base de datos Supabase (Opcional - si no se configuran, el sistema usa base de datos local automática)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta para acceder al panel de administración (/admin)
ADMIN_SECRET_KEY=TICS2026

# Puerto del servidor local
PORT=3000
